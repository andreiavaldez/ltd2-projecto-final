    <div class="container">
        <h2>Before & After</h2>
        <p class="project-intro-centered">
            A transformation from a cluttered, overwhelming interface to a clean, accessible design that
            respects neurodivergent user needs and improves content clarity.
        </p>
        <div class="project-grid">
            <div class="wireframe-section">
                <h3 class="before-label">Before</h3>
                <img src="img/projects/brainstorm/before.png"
                     srcset="img/projects/brainstorm/before.png 1x, img/projects/brainstorm/before2x.png 2x"
                     alt="Brainstorm PHDA interface before redesign">
