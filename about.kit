        </div>
    </section>
    <!-- Secção de Formação e Experiência-->
    <section class="section">
        <div class="container">
            <div class="inline-heading">
                <p class="tag">Percurso</p>
                <h2>Formação e Experiência</h2>
            </div>
            <div class="container timeline-grid">

                <!-- Formação -->
                <div class="timeline-column">
                    <h2 class="timeline-title">Formação</h2>

                    <div class="timeline-item">
                        <span class="timeline-dot"></span>

                        <div class="timeline-content">
                            <span class="timeline-date">2016 – 2018</span>
                            <h3>Mestrado em Design de Comunicação</h3>
                            <h4>Faculdade de Belas-Artes de Lisboa</h4>
                            <p>
                                Especialização em Design de Interação e Experiência do Utilizador.
                                Dissertação sobre acessibilidade em interfaces digitais.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <span class="timeline-dot"></span>

                        <div class="timeline-content">
                            <span class="timeline-date">2013 – 2016</span>
                            <h3>Licenciatura em Design</h3>
                            <h4>IADE – Creative University</h4>
                            <p>
                                Formação em design gráfico, tipografia e fundamentos de design de
                                interfaces. Projeto final premiado no Young Creative Portugal.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <span class="timeline-dot"></span>

                        <div class="timeline-content">
                            <span class="timeline-date">2022</span>
                            <h3>Google UX Design Professional Certificate</h3>
                            <h4>Google / Coursera</h4>
                            <p>
                                Certificação profissional em UX Design abrangendo todo o processo de
                                design centrado no utilizador.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Experiência -->
                <div class="timeline-column">
                    <h2 class="timeline-title">Experiência Profissional</h2>

                    <div class="timeline-item">
                        <span class="timeline-dot"></span>

                        <div class="timeline-content">
                            <span class="timeline-date">2021 – Presente</span>
                            <h3>Senior UX/UI Designer</h3>
                            <h4>Talkdesk</h4>
                            <p>
                                Lidero a equipa de design do produto principal de contact center.
                                Responsável pela estratégia de design, sistemas de componentes e
                                mentoria de designers júnior.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <span class="timeline-dot"></span>

                        <div class="timeline-content">
                            <span class="timeline-date">2019 – 2021</span>
                            <h3>UX/UI Designer</h3>
                            <h4>Farfetch</h4>
                            <p>
                                Design de experiências de e-commerce para a plataforma de luxo.
                                Colaboração com equipas internacionais em projetos de checkout e
                                descoberta de produtos.
                            </p>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <span class="timeline-dot"></span>

                        <div class="timeline-content">
                            <span class="timeline-date">2018 – 2019</span>
                            <h3>Junior Designer</h3>
                            <h4>Publicis Portugal</h4>
                            <p>
                                Início de carreira em agência de publicidade, trabalhando em
                                campanhas digitais para marcas como Vodafone, Nestlé e TAP.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>
