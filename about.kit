<!-- Secção de Competências -->
    <section class="section light">
        <div class="container">
            <div class="inline-heading">
                <p class="tag">Skills</p>
                <h2>Competências</h2>
            </div>
            <div class="skills">
                <div>
                    <h3>Design Visual</h3>
                    <div class="pills">
                        <span class="pill">Figma</span>
                        <span class="pill">Adobe XD</span>
                        <span class="pill">Sketch</span>
                        <span class="pill">Adobe Illustrator</span>
                        <span class="pill">Adobe Photoshop</span>
                        <span class="pill">Framer</span>
                        <span class="pill">Principle</span>
                    </div>
                </div>
                <div>
                    <h3>UX Research</h3>
                    <div class="pills">
                        <span class="pill">Testes de usabilidade</span>
                        <span class="pill">Wireframes</span>
                        <span class="pill">Protótipos</span>
                    </div>
                </div>
                <div>
                    <h3>Desenvolvimento</h3>
                    <div class="pills">
                        <span class="pill">HTML</span>
                        <span class="pill">CSS</span>
                    </div>
                </div>
                <div>
                    <h3>Soft Skills</h3>
                    <div class="pills">
                        <span class="pill">Comunicação</span>
                        <span class="pill">Trabalho em equipa</span>
                    </div>
                </div>
