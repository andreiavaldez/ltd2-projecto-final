                     alt="Academia Portugal Digital interface before redesign">
            </div>
            <div class="wireframe-section">
                <h3 class="after-label">After</h3>
                <img src="img/projects/apd/after.png"
                     srcset="img/projects/apd/after.png 1x, img/projects/apd/after@2x.png 2x"
                     alt="Academia Portugal Digital interface after redesign">
            </div>
        </div>
    </div>
</section>

